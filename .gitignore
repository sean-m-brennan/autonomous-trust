# Ignore generated content in the Dash assets_folder, but TRACK the source
# assets the dashboard needs at runtime (demo.css, row_resize.js, fonts,
# images). Without these tracked, clean builds render the dashboard unstyled
# and the graph container reflows every tick. Add any further source asset
# filenames as negations below.
/src/autonomous-trust-inspector/autonomous_trust/inspector/dash_components/assets/*
!/src/autonomous-trust-inspector/autonomous_trust/inspector/dash_components/assets/demo.css
!/src/autonomous-trust-inspector/autonomous_trust/inspector/dash_components/assets/row_resize.js
/src/autonomous-trust/autonomous_trust/core/protobuf

