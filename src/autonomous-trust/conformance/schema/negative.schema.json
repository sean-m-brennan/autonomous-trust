{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://autonomous-trust/conformance/schema/negative.schema.json",
  "title": "AT Conformance Negative Case (kind: negative)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "protocol", "name", "based_on", "mutation", "expected"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1"]},
    "kind": {"const": "negative"},
    "protocol": {"type": "string", "enum": ["identity", "reputation", "negotiation", "network", "agreement"]},
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "description": {"type": "string"},
    "based_on": {
      "type": "string",
      "description": "Path to the base scenario or wire_vector YAML, relative to the corpus root."
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "target"],
      "properties": {
        "step_id": {"type": "integer", "minimum": 1},
        "op": {
          "type": "string",
          "enum": ["flip_byte", "truncate", "append", "replace", "drop_field", "set_field", "inflate"]
        },
        "target": {
          "type": "string",
          "description": "What part of the message/step to mutate: signature | wire_bytes | payload.<field> | envelope.<field>"
        },
        "index": {"type": "integer"},
        "value": {"type": ["string", "integer", "boolean", "null"]},
        "content_hex": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]*$",
          "description": "Raw replacement bytes encoded as hex (no 0x prefix). Used by op=replace target=wire_bytes to inject non-JSON garbage."
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "description": "Target binary size for op=inflate target=payload — the wire `data` field is replaced with base64-of-N-zero-bytes. Two reason_class regimes split at 768 KB raw (≈1 MB wire after base64): sizes below 768 KB → signature_verification_failed (parser accepts, sig mismatches); sizes at or above 768 KB → payload_oversized (parser's envelope size cap, Network.max_wire_bytes / NET_MSG_MAX_DATA = 1 MB, rejects before json.loads)."
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason_class"],
      "properties": {
        "reject_at_step": {"type": "integer", "minimum": 1},
        "reason_class": {
          "type": "string",
          "enum": [
            "signature_verification_failed",
            "envelope_malformed",
            "envelope_truncated",
            "payload_oversized",
            "replay_detected",
            "decryption_failed",
            "unknown_function",
            "schema_violation"
          ]
        }
      }
    }
  }
}
