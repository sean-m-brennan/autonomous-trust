# Kernel options for the devel image only, applied on top of kernel.defconfig.
# Each makes the node easier to watch while it is being brought up, and none
# belongs on a fielded node.

# Kernel console on HDMI. The Pi's U-Boot leaves the firmware framebuffer
# running and describes it to the kernel as a simple-framebuffer node, which
# simpledrm drives. Output only: there are no keyboard or HID drivers.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# Green ACT LED: the device tree gives it the heartbeat trigger, so it blinks
# for as long as the kernel is alive
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_HEARTBEAT=y

# Embed this config in the kernel, readable at /proc/config.gz and by
# verify-image.sh
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
