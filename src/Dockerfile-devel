# Runs a custom AutonomousTrust module from (all) live sources

# Build from repo base dir:
#    docker build -t autonomous-trust-full-devel  -f src/Dockerfile-devel .
# For rapid development, run as:
#    docker run --rm -u $(id -u):$(id -g) -v examples/requestor/requestor.py:/app/requestor.py -e AUTONOMOUS_TRUST_EXE=requestor.py -it autonomous-trust-full-devel

ARG REGISTRY_URL
ARG IMAGE_TAG
FROM ${REGISTRY_URL}autonomous-trust-devel${IMAGE_TAG}

USER root
RUN apt-get update && apt-get install -y libgl1 libglx-mesa0

WORKDIR /app
USER user

COPY --chown=user:user src/autonomous-trust/autonomous_trust/core autonomous_trust/core
COPY --chown=user:user src/autonomous-trust-inspector/autonomous_trust/inspector autonomous_trust/inspector
COPY --chown=user:user src/autonomous-trust-services/autonomous_trust/services autonomous_trust/services
COPY --chown=user:user src/autonomous-trust-simulator/autonomous_trust/simulator autonomous_trust/simulator

# update and install any new dependencies from environment.yml
#
# BOTH spec files, and both where setup-dev.sh looks for them. The script reads
# `$REPO_DIR/environment.yml` (= /app/environment.yml, the second copy below)
# and `$CFG_DIR/devel_environ.yml` (= /app/config/cfg/devel_environ.yml). Only
# environment.yml used to be copied, so the toolchain half of the update was a
# silent no-op -- and while the update still pruned, that meant this image lost
# the dev toolchain (gxx_linux-64, clang, poetry, pytest) the base image had
# installed, with nothing to put it back. A devel image without a compiler also
# cannot build the one pip dep that has no wheel; see the pykcs11 note in
# config/cfg/environment.yml.
COPY --chown=user:user config/cfg/environment.yml /build/config/cfg/environment.yml
COPY --chown=user:user config/cfg/environment.yml ./environment.yml
COPY --chown=user:user config/cfg/devel_environ.yml config/cfg/devel_environ.yml
COPY --chown=user:user scripts/*.sh scripts/
RUN scripts/setup-dev.sh --update
