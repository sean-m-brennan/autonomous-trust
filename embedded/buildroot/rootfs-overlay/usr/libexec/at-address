#!/bin/sh
# Give the node the one IPv4 address AT runs on, whether or not a router is
# there. AT records its address in its identity on the first start and keeps
# it, so the address must not change when Wi-Fi falls back from the router to
# the ad-hoc cell and back. It goes on the link as a static address, beside
# any DHCP lease, and stays through both.
#
# The address comes from, in order:
#   1. /boot/at-address.conf, written by the operator after flashing;
#   2. the copy saved on the data partition by an earlier boot;
#   3. the first DHCP lease, which is then saved as that copy.
# With none of them the node has no address for AT. This logs that as an
# error every minute and keeps waiting for a lease, so AT starts if a router
# turns up.
#
# The file holds KEY=value lines:
#   ADDRESS=10.42.0.11/16   address and prefix, required
#   INTERFACE=wlan0         optional; wlan0 when /boot/wpa_supplicant.conf
#                           exists, eth0 otherwise
set -eu

BOOT_CONF="${AT_ADDRESS_BOOT_CONF:-/boot/at-address.conf}"
SAVED_CONF="${AT_ADDRESS_SAVED_CONF:-/opt/autonomous-trust/etc/at/address.conf}"
BOOTSTRAP="${AT_ADDRESS_BOOTSTRAP:-/opt/autonomous-trust/etc/at/bootstrap/bootstrap.cfg.json}"
NETWORK_RUN="${AT_ADDRESS_NETWORK_RUN:-/run/systemd/network}"
WPA_CONF="${AT_ADDRESS_WPA_CONF:-/boot/wpa_supplicant.conf}"

info()  { echo "<6>$*" >&2; }
error() { echo "<3>$*" >&2; }

# First global IPv4 address with prefix on eth0 or wlan0, as "IFACE ADDR/LEN".
# Nothing else puts one there before this script does, so it is a DHCP lease.
leased() {
    for ifc in eth0 wlan0; do
        a="$(ip -4 -o addr show dev "$ifc" 2>/dev/null \
            | sed -n 's/.* inet \([0-9.]*\/[0-9]*\) .*scope global.*/\1/p' | head -n 1)"
        if [ -n "$a" ]; then
            echo "$ifc $a"
            return 0
        fi
    done
    return 1
}

# Parsed, not sourced: anyone with the card can write the boot partition, and
# this runs as root
conf_value() {
    sed -n "s/^[[:space:]]*$2=[\"']\{0,1\}\([^\"' ]*\)[\"']\{0,1\}[[:space:]]*\$/\1/p" "$1" | tail -n 1
}

read_conf() {
    ADDRESS="$(conf_value "$1" ADDRESS)"
    INTERFACE="$(conf_value "$1" INTERFACE)"
    case "$ADDRESS" in
        *.*.*.*/*) ;;
        *) error "$1: ADDRESS=$ADDRESS is not an IPv4 address with a prefix, such as 10.42.0.11/16"
           exit 1 ;;
    esac
    if [ -z "$INTERFACE" ]; then
        if [ -f "$WPA_CONF" ]; then INTERFACE=wlan0; else INTERFACE=eth0; fi
    fi
    case "$INTERFACE" in
        eth0|wlan0) ;;
        *) error "$1: INTERFACE=$INTERFACE is not eth0 or wlan0"
           exit 1 ;;
    esac
}

if [ -f "$BOOT_CONF" ]; then
    read_conf "$BOOT_CONF"
    info "Using $ADDRESS on $INTERFACE from $BOOT_CONF"
elif [ -f "$SAVED_CONF" ]; then
    read_conf "$SAVED_CONF"
    info "Using $ADDRESS on $INTERFACE, saved from an earlier DHCP lease in $SAVED_CONF"
else
    waited=0
    while ! lease="$(leased)"; do
        if [ "$waited" -ge 60 ] && [ $((waited % 60)) -eq 0 ]; then
            error "No address for AT: no $BOOT_CONF, none saved in $SAVED_CONF," \
                  "and no DHCP lease after ${waited}s. AT will not start until one" \
                  "of them exists. Write $BOOT_CONF on the boot partition or" \
                  "connect the node to a network with DHCP."
        fi
        sleep 5
        waited=$((waited + 5))
    done
    INTERFACE="${lease%% *}"
    ADDRESS="${lease#* }"
    mkdir -p "$(dirname "$SAVED_CONF")"
    printf 'ADDRESS=%s\nINTERFACE=%s\n' "$ADDRESS" "$INTERFACE" > "$SAVED_CONF.tmp"
    mv "$SAVED_CONF.tmp" "$SAVED_CONF"
    info "Saved DHCP lease $ADDRESS on $INTERFACE to $SAVED_CONF; it is this node's address from now on"
fi

case "$INTERFACE" in
    eth0)  network=20-eth0.network ;;
    wlan0) network=30-wlan0.network ;;
esac

# A runtime drop-in on the image's own .network file. ConfigureWithoutCarrier
# keeps the address while Wi-Fi changes cells, when the link briefly loses its
# carrier. KeepConfiguration=dhcp matters when the address is also the
# router's lease: networkd would otherwise remove it when the lease lapses.
mkdir -p "$NETWORK_RUN/$network.d"
cat > "$NETWORK_RUN/$network.d/50-at-address.conf" <<EOF
[Network]
Address=$ADDRESS
ConfigureWithoutCarrier=yes
KeepConfiguration=dhcp
EOF
networkctl reload
networkctl reconfigure "$INTERFACE"

# AT's generator picks the interface whose subnet holds the bootstrap address
# and takes that address as its own. Without this it takes the first IPv4
# address it finds, which can be a lease beside the static one. Leave a
# provisioned bootstrap file alone.
if [ ! -f "$BOOTSTRAP" ]; then
    mkdir -p "$(dirname "$BOOTSTRAP")"
    printf '{"node_address": "%s"}\n' "${ADDRESS%/*}" > "$BOOTSTRAP"
fi

waited=0
until ip -4 -o addr show dev "$INTERFACE" | grep -q " inet ${ADDRESS%/*}/"; do
    if [ "$waited" -ge 30 ]; then
        error "$ADDRESS did not appear on $INTERFACE within 30s"
        exit 1
    fi
    sleep 1
    waited=$((waited + 1))
done
info "$ADDRESS is up on $INTERFACE"
