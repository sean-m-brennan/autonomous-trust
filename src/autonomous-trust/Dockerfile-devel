# Runs AutonomousTrust from live sources

# Build from repo base dir:
#    docker build -t autonomous-trust-devel -f src/autonomous-trust/Dockerfile-devel .
# For rapid development, run as:
#    docker run --rm -u $(id -u):$(id -g) -v src/autonomous-trust:/app -it autonomous-trust-devel

FROM condaforge/miniforge3

ARG http_proxy
ARG https_proxy
ARG no_proxy
ARG CERT_CONTENT

# Propagate proxy settings so conda run subprocesses inherit them
ENV http_proxy=${http_proxy}
ENV https_proxy=${https_proxy}
ENV no_proxy=${no_proxy}

WORKDIR /app
SHELL ["/bin/bash", "-c"]

# Install CA cert for proxy if provided (must happen before any network access)
RUN if [ -n "$CERT_CONTENT" ]; then \
      echo "$CERT_CONTENT" > /usr/local/share/ca-certificates/proxy-ca.crt && \
      cat /usr/local/share/ca-certificates/proxy-ca.crt >> /etc/ssl/certs/ca-certificates.crt && \
      conda config --set ssl_verify /etc/ssl/certs/ca-certificates.crt; \
    fi
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

RUN apt-get update && \
    apt-get install -y build-essential mercurial iproute2 iputils-ping iputils-arping iputils-tracepath nfs-common sudo curl jq && \
    apt-get clean || true

RUN useradd -U user -d /app
RUN echo "ALL            ALL = (ALL) NOPASSWD: ALL" >>/etc/sudoers
RUN chmod -R 0777 /opt/conda
RUN chown -R user:user /app
RUN mkdir /build
RUN chown -R user:user /build
USER user

# The conda-pypi:: specs in devel_environ.yml (jcs, mermaid-cli) resolve through
# the rattler solver (the classic/libmamba solver can't fetch jcs). Install the
# rattler solver plugin into base and select it so the env create/update below
# use it.
#
# `repodata_use_shards false` works around an UPSTREAM conda bug, not anything
# of ours (2026-08-04, conda 26.7.0 / conda-rattler-solver 0.1.1 / py-rattler
# 0.25.0). conda's sharded-repodata reader decompresses each shard through
# `capped_decompress(data, max_output_size=ZSTD_MAX_SHARD_SIZE)`
# (`conda/_private/zstd.py`), and `ZSTD_MAX_SHARD_SIZE` is a hard-coded 16 MiB
# constant with no config knob. A conda-forge shard has outgrown it, so the
# fetch dies with `backports.zstd.ZstdError: decompressed output exceeds
# 16777216 bytes` and the whole solve fails.
#
# This setting is the right lever rather than switching solvers, because it is
# the one the rattler solver itself checks — `conda_rattler_solver/index.py`:
#
#     def _is_sharded_repodata_enabled():
#         return getattr(context, "repodata_use_shards", True)
#     ...
#     if self.in_state and self.build_repodata_subset and _is_sharded_repodata_enabled():
#
# so a false here takes the documented "fall back to non-sharded path" branch
# and keeps the rattler solver the conda-pypi:: specs above need. Dropping to
# classic/libmamba to dodge the shard code would break those instead.
#
# That same line explains why `env create` below survived and `env update`
# failed: the sharded path also requires `in_state`, which is populated for an
# update against an existing env, not for a fresh create.
#
# Cost: repodata fetches go back to full `repodata.json`, so the solve is
# slower (the shard format exists to avoid exactly that). Revisit when conda
# either raises the cap or makes it configurable. ISSUES.md §9.1 holds the
# durable half of this: the base image and this solver plugin are both
# unpinned, which is why an upstream change reached a working build at all.
RUN conda install -n base -y conda-rattler-solver && \
    conda config --set solver rattler && \
    conda config --set repodata_use_shards false

COPY --chown=user:user config/cfg/environment.yml /build/config/cfg/environment.yml
COPY --chown=user:user config/cfg/devel_environ.yml /build/config/cfg/devel_environ.yml
RUN --mount=type=cache,target=/opt/conda/pkgs conda env create -n autonomous_trust --file /build/config/cfg/environment.yml
RUN --mount=type=cache,target=/opt/conda/pkgs conda env update -n autonomous_trust --file /build/config/cfg/devel_environ.yml


SHELL ["conda", "run", "--live-stream", "-n", "autonomous_trust", "/bin/bash", "-c"]
RUN pip install pydevd-pycharm

#COPY --chown=user:user src/autonomous-trust/.bashrc .bashrc
COPY --chown=user:user src/autonomous-trust/rust rust
COPY --chown=user:user src/autonomous-trust/autonomous_trust autonomous_trust
RUN rm -rf autonomous_trust/etc autonomous_trust/var

# if using rust, swap with lines below
#COPY --chown=user:user src/autonomous-trust/rust-project.toml pyproject.toml
#RUN maturin develop

COPY --chown=user:user src/autonomous-trust/pyproject.toml pyproject.toml
RUN poetry install

ENV POSTMORTEM=true
ENV AUTONOMOUS_TRUST_ROOT="/app/config"

COPY src/autonomous-trust/entrypoint.sh /bin/entrypoint.sh
ENV ROUTER="172.17.0.1"
ENTRYPOINT ["/bin/entrypoint.sh"]