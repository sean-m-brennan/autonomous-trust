#!/bin/sh
# Grow the data partition (partition 3, the last on the card) to the end of
# the card. The image carries a small data partition so that it fits any card;
# this runs before the partition is checked and mounted, and the fstab entry's
# x-systemd.growfs then grows the ext4 filesystem to match once it is mounted.
#
# The boot and root partitions are in use, so the kernel cannot re-read the
# whole partition table. sfdisk writes the new size without asking it to, and
# partx tells the kernel about partition 3 alone, which is not mounted yet.
set -eu

part="$(realpath /dev/disk/by-partuuid/41540001-03)"   # e.g. /dev/mmcblk0p3
name="${part##*/}"
disk="$(basename "$(realpath "/sys/class/block/$name/..")")"

start="$(cat "/sys/class/block/$name/start")"           # 512-byte sectors
size="$(cat "/sys/class/block/$name/size")"
total="$(cat "/sys/block/$disk/size")"
free=$((total - start - size))

# Already grown, or a card the image fills: leave the table alone, so that
# it is written once, on the first boot, and never again
if [ "$free" -lt 32768 ]; then
    exit 0
fi

echo "Growing $part by $((free / 2048)) MiB to the end of /dev/$disk"
echo ", +" | sfdisk --no-reread --no-tell-kernel -N 3 "/dev/$disk"
partx -u --nr 3 "/dev/$disk"

# partx makes the kernel announce partition 3 again. The fstab mount is bound
# to the partition's device, and on a Pi 4 a mount started while udev was still
# handling that announcement was unmounted again at once, taking the data
# directory from under AT and Dropbear. Return only once udev is done.
udevadm settle
