# Puts AT's address on the link as a static address, from /boot/at-address.conf
# or the node's first DHCP lease, so that AT keeps one address with or without
# a router. autonomous-trust.service waits for it. With no address to use it
# waits, logging an error every minute.

[Unit]
Description=AT node address (/boot/at-address.conf or first DHCP lease)
Documentation=file:/usr/libexec/at-address
# network-online.target gives DHCP up to 30 s first (the wait-online drop-in),
# so that a node with a router finds its lease at once
After=systemd-networkd.service boot.mount network-online.target
Requires=systemd-networkd.service boot.mount
Wants=network-online.target
RequiresMountsFor=/opt/autonomous-trust

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/at-address
TimeoutStartSec=infinity
