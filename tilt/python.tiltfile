# Tiltfile for AutonomousTrust multi-node demo (Python / Python+native backend)
# Usage: tilt up -- --num-nodes=4 [--exclude-logs=network] [--log-level=debug] [--backend=native|python]

# We only use docker_compose, not k8s -- allow whatever context is active
allow_k8s_contexts(k8s_context())

num_nodes = os.getenv("_TILT_NUM_NODES", "2")
exclude_logs = os.getenv("_TILT_EXCLUDE_LOGS", "network")
log_level = os.getenv("_TILT_LOG_LEVEL", "info")
backend = os.getenv("_TILT_BACKEND", "native")
metrics_dir = os.getenv("_TILT_METRICS_DIR", "")

# Generate docker-compose.tilt.yaml for the requested number of nodes
local("cd .. && python3 gen_compose.py " + num_nodes + " " + exclude_logs + " " + log_level + " " + backend, quiet=True, echo_off=True)

# Build args: pass through proxy env vars if set
build_args = {}
for var in ["http_proxy", "https_proxy", "no_proxy"]:
    val = os.getenv(var, "")
    if val:
        build_args[var] = val

# Auto-detect proxy CA cert: env var first, then well-known filesystem path
cert_content = os.getenv("CERT_CONTENT", "")
if not cert_content:
    cert_path = "/usr/local/share/ca-certificates/proxy-ca.crt"
    result = str(local("cat " + cert_path + " 2>/dev/null || true", quiet=True, echo_off=True))
    if result.strip():
        cert_content = result.strip()
if cert_content:
    build_args["CERT_CONTENT"] = cert_content

# Get version from git for C library build
git_version = str(local("git describe HEAD 2>/dev/null || echo unknown", quiet=True, echo_off=True)).strip()
git_version = git_version.removeprefix("v")
build_args["GIT_VERSION"] = git_version

# All paths are relative to this tiltfile's directory (tilt/),
# so use ".." to reference the repo root.
repo_root = ".."

# Select Dockerfile based on backend
if backend == "native":
    dockerfile = repo_root + "/src/autonomous-trust/Dockerfile-native"
else:
    dockerfile = repo_root + "/src/autonomous-trust/Dockerfile-lite"

# Build the base image
docker_build(
    "autonomous-trust",
    repo_root,
    dockerfile=dockerfile,
    network="host",
    build_args=build_args,
)

# Build the full-devel image chain when metrics collection is enabled.
# autonomous-trust-full-devel depends on autonomous-trust-devel.
if metrics_dir:
    docker_build(
        "autonomous-trust-devel",
        repo_root,
        dockerfile=repo_root + "/src/autonomous-trust/Dockerfile-devel",
        network="host",
        build_args=build_args,
    )
    docker_build(
        "autonomous-trust-full-devel",
        repo_root,
        dockerfile=repo_root + "/src/Dockerfile-devel",
        network="host",
        build_args=build_args,
    )

# Load the generated compose file
docker_compose(repo_root + "/docker-compose.tilt.yaml")

# Watch key source dirs for live rebuild triggers
watch_file(repo_root + "/src/autonomous-trust/autonomous_trust")
watch_file(repo_root + "/src/autonomous-trust/entrypoint.sh")
watch_file(repo_root + "/src/protobuf")
if backend == "native":
    watch_file(repo_root + "/src/c")
if metrics_dir:
    watch_file(repo_root + "/src/autonomous-trust-inspector/autonomous_trust")
    watch_file(repo_root + "/src/autonomous-trust-services/autonomous_trust")
    watch_file(repo_root + "/src/autonomous-trust-simulator/autonomous_trust")
