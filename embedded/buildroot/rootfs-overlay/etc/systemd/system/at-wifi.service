# Associates wlan0 with the network named in wpa_supplicant.conf on the FAT
# boot partition. The file is written from any PC after flashing, so no
# credentials are built into the image. Without the file, wlan0 stays down.
#
# /etc/wpa_supplicant/at-adhoc.conf adds the ad-hoc cell that AT nodes fall
# back to when that network is out of range, and the control socket that
# at-wifi-prefer-ap.timer uses to move back to it. A file with no network
# block at all, only country=, puts the node straight into the ad-hoc cell.

[Unit]
Description=Wi-Fi association for wlan0 (/boot/wpa_supplicant.conf)
BindsTo=sys-subsystem-net-devices-wlan0.device
After=sys-subsystem-net-devices-wlan0.device boot.mount
Requires=boot.mount
Before=network.target
Wants=network.target
ConditionPathExists=/boot/wpa_supplicant.conf

[Service]
Type=simple
ExecStart=/usr/sbin/wpa_supplicant -i wlan0 -D nl80211 -c /boot/wpa_supplicant.conf -I /etc/wpa_supplicant/at-adhoc.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=sys-subsystem-net-devices-wlan0.device
