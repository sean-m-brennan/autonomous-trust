# Minimal Linux kernel config for Autonomous Trust on Pi4/CM4
# Base: bcm2711_defconfig, stripped for single-purpose appliance

# Architecture
CONFIG_ARCH_BCM2835=y
CONFIG_ARM64=y
CONFIG_SMP=y
CONFIG_NR_CPUS=4

# Scheduler / core
CONFIG_PREEMPT=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_CGROUPS=y
CONFIG_NAMESPACES=y

# Networking (essential for AT)
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_IP_MULTICAST=y
CONFIG_IP_UDP=y
CONFIG_NETFILTER=n

# Device mapper + dm-verity
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_DM_VERITY_VERIFY_ROOTHASH_SIG=y
CONFIG_CRYPTO_SHA256=y

# Storage
CONFIG_MMC=y
CONFIG_MMC_BCM2835=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y

# Serial / console
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# USB (for initial provisioning)
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC2=y
CONFIG_USB_STORAGE=y

# Virtio (for QEMU testing)
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y

# Disable unnecessary subsystems
CONFIG_SOUND=n
CONFIG_DRM=n
CONFIG_FB=n
CONFIG_VGA_CONSOLE=n
CONFIG_INPUT_MOUSEDEV=n
CONFIG_INPUT_JOYDEV=n
CONFIG_INPUT_TOUCHSCREEN=n
CONFIG_HID=n
CONFIG_MEDIA_SUPPORT=n
CONFIG_WLAN=n
CONFIG_BLUETOOTH=n
CONFIG_NFS_FS=n
CONFIG_CIFS=n
CONFIG_DEBUG_KERNEL=n
CONFIG_FTRACE=n
CONFIG_KPROBES=n
CONFIG_PROFILING=n
