[Unit]
Description=Autonomous Trust Node
After=network-online.target
Wants=network-online.target
Documentation=https://github.com/TekFive/autonomous-trust

[Service]
Type=simple
Environment=AUTONOMOUS_TRUST_ROOT=/opt/autonomous-trust
Environment=LOG_LEVEL=info
Environment=STARTUP_DELAY=0
EnvironmentFile=-/opt/autonomous-trust/etc/at/environment

ExecStartPre=/bin/mkdir -p /opt/autonomous-trust/etc/at /opt/autonomous-trust/var/at
ExecStartPre=/bin/sh -c '[ "${STARTUP_DELAY:-0}" -le 0 ] 2>/dev/null || sleep "$STARTUP_DELAY"'
ExecStart=/bin/sh -c 'exec /opt/autonomous-trust/bin/at_demo --generate-config --log-level ${LOG_LEVEL} ${AUTONOMOUS_TRUST_ARGS}'
Environment=LD_LIBRARY_PATH=/opt/autonomous-trust/lib

Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/autonomous-trust
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
