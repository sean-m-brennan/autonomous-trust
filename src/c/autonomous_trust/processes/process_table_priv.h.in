#ifndef PROCESS_TABLE_H
#define PROCESS_TABLE_H

#include "processes/process_tracker.h"

#define QUOTE(x) #x

#define DECLARE_PROCESS(type_name, proc_name, run_func) \
    {                                                   \
        .type = QUOTE(type_name),                       \
        .name = QUOTE(proc_name),                       \
        .runner = run_func,                             \
    },

/* The generated entries, plus AT_PROCESS_EXT_MAX free slots an extension
 * library fills at load time with DEFINE_PROCESS (process_tracker.h). */
proc_map_t process_table[LIST_COUNT__DECLARE_PROCESS + AT_PROCESS_EXT_MAX] = {
    LIST__DECLARE_PROCESS};

#endif // PROCESS_TABLE_H
