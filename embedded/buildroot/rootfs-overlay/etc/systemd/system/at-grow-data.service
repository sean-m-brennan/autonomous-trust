[Unit]
Description=Grow the data partition to fill the card
Documentation=file:/usr/libexec/at-grow-data
DefaultDependencies=no
Requires=dev-disk-by\x2dpartuuid-41540001\x2d03.device
After=dev-disk-by\x2dpartuuid-41540001\x2d03.device
Before=systemd-fsck@dev-disk-by\x2dpartuuid-41540001\x2d03.service opt-autonomous\x2dtrust.mount local-fs-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/at-grow-data

[Install]
WantedBy=local-fs-pre.target
