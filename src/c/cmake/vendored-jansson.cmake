# Vendored jansson: the git submodule at third_party/jansson (our fork), built
# statically into the C core.
#
# 1. Numbers are formatted and parsed by David Gay's dtoa.c, not the libc.
#    glibc's printf and strtod are correctly rounded; others are not
#    (uClibc-ng, the libc for SPARC V8 / LEON3 Linux, misreads about a quarter
#    of three-decimal values), and nodes that convert differently sign and hash
#    different bytes. Upstream 2.15 formats with dtoa (USE_DTOA, forced on
#    here) but still parses with the libc's strtod, and keeps dtoa's bignum
#    cache in unlocked statics; the fork parses with dtoa's strtod
#    (dtoa_strtod) and keeps that state per thread. An upstream tree builds,
#    but parses through the libc and is not thread safe.
#
# 2. Every exported json_* / jansson_* function is renamed at_jansson_json_* /
#    at_jansson_jansson_* (from jansson's own export list, src/jansson.def),
#    and only those are exported. The core and every extension library share
#    the one copy, and a system libjansson loaded into the same process (by
#    Python, or a host application) cannot be confused with it.
#    (at_jansson_ rather than at_json_: utilities/at_jansson.h already owns
#    names such as at_json_integer.)
#
# Code keeps writing `#include <jansson.h>` and json_*(): the include path
# puts a wrapper jansson.h first, which applies the renames and exports.
#
# Sets AT_JANSSON_TARGET (link this), AT_JANSSON_WRAPPER_DIR (must come first
# on the include path) and AT_JANSSON_CONFIG_DIR (jansson_config.h).

set(AT_JANSSON_SOURCE_DIR ${CMAKE_CURRENT_SOURCE_DIR}/third_party/jansson
    CACHE PATH "jansson source tree (the third_party/jansson submodule)")

if(NOT EXISTS ${AT_JANSSON_SOURCE_DIR}/src/jansson.h)
    message(FATAL_ERROR
        "jansson sources not found at ${AT_JANSSON_SOURCE_DIR}.\n"
        "They are a git submodule: run\n"
        "  git submodule update --init src/c/third_party/jansson\n"
        "(or pass -DAT_JANSSON_SOURCE_DIR=<a checkout of the AT jansson fork>).")
endif()
file(STRINGS ${AT_JANSSON_SOURCE_DIR}/src/strconv.c _at_jansson_dtoa_strtod
     REGEX "dtoa_strtod")
if(NOT _at_jansson_dtoa_strtod)
    message(WARNING
        "${AT_JANSSON_SOURCE_DIR}/src/strconv.c does not call dtoa_strtod: this "
        "is not the AutonomousTrust jansson fork, so JSON numbers are parsed by "
        "the libc (not exact on uClibc-ng; the startup float self-test catches "
        "that) and dtoa.c is not thread safe.")
endif()

# jansson's own build, without the parts we do not use. Its
# cmake_minimum_required predates what CMake 4 accepts.
set(JANSSON_BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
set(JANSSON_EXAMPLES OFF CACHE BOOL "" FORCE)
set(JANSSON_BUILD_DOCS OFF CACHE BOOL "" FORCE)
set(JANSSON_WITHOUT_TESTS ON CACHE BOOL "" FORCE)
set(JANSSON_INSTALL OFF CACHE BOOL "" FORCE)
set(USE_DTOA ON CACHE BOOL "" FORCE)
set(_at_saved_policy_min "${CMAKE_POLICY_VERSION_MINIMUM}")
set(CMAKE_POLICY_VERSION_MINIMUM 3.5)
add_subdirectory(${AT_JANSSON_SOURCE_DIR} ${CMAKE_BINARY_DIR}/third_party/jansson
                 EXCLUDE_FROM_ALL)
set(CMAKE_POLICY_VERSION_MINIMUM "${_at_saved_policy_min}")
set(_at_jansson_bin ${CMAKE_BINARY_DIR}/third_party/jansson)

# --- the rename header, generated from jansson.def -------------------------
set(_at_jansson_wrap ${CMAKE_BINARY_DIR}/at_jansson_include)
file(STRINGS ${AT_JANSSON_SOURCE_DIR}/src/jansson.def _at_jansson_exports
     REGEX "^[ \t]+(json|jansson)_[A-Za-z0-9_]+[ \t]*$")
set(_at_rename "/* Generated by cmake/vendored-jansson.cmake from jansson.def */\n")
string(APPEND _at_rename "#ifndef AT_JANSSON_RENAME_H\n#define AT_JANSSON_RENAME_H\n")
foreach(_sym ${_at_jansson_exports})
    string(STRIP "${_sym}" _sym)
    string(APPEND _at_rename "#define ${_sym} at_jansson_${_sym}\n")
endforeach()
string(APPEND _at_rename "#endif\n")
file(CONFIGURE OUTPUT ${_at_jansson_wrap}/jansson_rename.h CONTENT "${_at_rename}")

# --- the wrapper every #include <jansson.h> resolves to ---------------------
# The API is declared under default visibility while the library is compiled
# -fvisibility=hidden, so the renamed API is all that leaves the archive.
file(CONFIGURE OUTPUT ${_at_jansson_wrap}/jansson.h CONTENT
"/* Generated by cmake/vendored-jansson.cmake: the vendored jansson, renamed. */
#ifndef AT_VENDORED_JANSSON_H
#define AT_VENDORED_JANSSON_H
#include \"jansson_rename.h\"
#pragma GCC visibility push(default)
#include \"${AT_JANSSON_SOURCE_DIR}/src/jansson.h\"
#pragma GCC visibility pop
#endif
")

# -Wno-error: this tree's strict flags reach the subproject, and upstream
# jansson does not build under them (as for Ryu, suppress rather than patch).
target_compile_options(jansson PRIVATE -Wno-error -Wno-float-equal
    -fvisibility=hidden -include ${_at_jansson_wrap}/jansson.h)

# --- what the devel package installs ----------------------------------------
# The same renaming for code built against an installed libautonomous_trust:
# include/autonomous_trust/jansson/ goes first on its include path (the .pc
# says so), and the archives back the static library.
set_target_properties(jansson PROPERTIES OUTPUT_NAME at_jansson)
file(CONFIGURE OUTPUT ${_at_jansson_wrap}/install/jansson.h CONTENT
"/* Installed by libautonomous_trust: the vendored jansson, renamed. */
#ifndef AT_VENDORED_JANSSON_H
#define AT_VENDORED_JANSSON_H
#include \"jansson_rename.h\"
#pragma GCC visibility push(default)
#include \"at_jansson_upstream.h\"
#pragma GCC visibility pop
#endif
")
set(_at_jansson_incdir include/autonomous_trust/jansson)
install(FILES ${_at_jansson_wrap}/install/jansson.h
              ${_at_jansson_wrap}/jansson_rename.h
              ${_at_jansson_bin}/include/jansson_config.h
        DESTINATION ${_at_jansson_incdir} COMPONENT core)
install(FILES ${AT_JANSSON_SOURCE_DIR}/src/jansson.h
        DESTINATION ${_at_jansson_incdir} RENAME at_jansson_upstream.h
        COMPONENT core)
install(TARGETS jansson
        ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR} COMPONENT core)
set(AT_PC_JANSSON_REQUIRES "")
set(AT_PC_JANSSON_CFLAGS "-I\${includedir}/autonomous_trust/jansson ")
set(AT_PC_JANSSON_LIBS_PRIVATE "-lat_jansson ")

set(AT_JANSSON_TARGET jansson)
set(AT_JANSSON_WRAPPER_DIR ${_at_jansson_wrap})
set(AT_JANSSON_CONFIG_DIR ${_at_jansson_bin}/include)
