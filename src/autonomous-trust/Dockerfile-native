# AutonomousTrust image with native C backend (CFFI)
# Builds the C library inside the image and sets AUTONOMOUS_TRUST_BACKEND=native.
# Build with:
#   docker build --network host -t autonomous-trust -f src/autonomous-trust/Dockerfile-native .

FROM continuumio/miniconda3

ARG http_proxy
ARG https_proxy
ARG no_proxy
ARG CERT_CONTENT

WORKDIR /app
SHELL ["/bin/bash", "-c"]

# Install CA cert for proxy if provided
RUN if [ -n "$CERT_CONTENT" ]; then \
      echo "$CERT_CONTENT" > /usr/local/share/ca-certificates/proxy-ca.crt && \
      cat /usr/local/share/ca-certificates/proxy-ca.crt >> /etc/ssl/certs/ca-certificates.crt; \
    fi
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
ENV PIP_CERT=/etc/ssl/certs/ca-certificates.crt

# Network tools + C build toolchain
# AllowInsecure / --allow-unauthenticated tolerate transient apt
# InRelease "not live until" timestamps when the host clock is earlier
# than Debian's daily resign cycle. Harmless for a dev image fetched
# behind an HTTPS proxy.
RUN (apt-get update -y -o Acquire::AllowInsecureRepositories=true || true) && \
    apt-get install -y --no-install-recommends --allow-unauthenticated \
        iproute2 iputils-ping \
        cmake clang make pkg-config \
        uuid-dev libsodium-dev libjansson-dev \
        protobuf-compiler protobuf-c-compiler libprotobuf-c-dev libprotobuf-dev && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY src/autonomous-trust/entrypoint.sh /bin/entrypoint.sh
ENV ROUTER="172.17.0.1"
ENTRYPOINT ["/bin/entrypoint.sh"]

COPY src/autonomous-trust/requirements.txt /app/requirements.txt
RUN pip install -r /app/requirements.txt && pip install protobuf cffi

# --- ZK-STARK proof extension (autonomous_trust_zkp) -------------------
# Build the PyO3/maturin Rust extension so ZKP_AVAILABLE is True at runtime
# and task-result proofs are generated/verified instead of scored as
# "indeterminate". Build-time only: the Rust toolchain is removed after the
# wheel is installed, to keep the image lean. Heavy build (Plonky3 STARK
# deps + LTO release) and needs network access to crates.io + sh.rustup.rs
# at build time.
#
# Deliberately NON-FATAL: if the toolchain, registry, or build fails, the
# image still builds and the runtime degrades gracefully — automate.py
# scores task results on successful completion when ZKP_AVAILABLE is False
# (see the TaskResult branch). Verify after build with:
#   docker run --rm <image> python3 -c \
#     "from autonomous_trust.core._zkp import ZKP_AVAILABLE; print(ZKP_AVAILABLE)"
# To make a missing ZKP a hard build error instead, drop the `|| echo ...`.
COPY src/autonomous-trust/rust /app/zkp-rust
RUN ( curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
        | sh -s -- -y --profile minimal && \
      . "$HOME/.cargo/env" && \
      pip install "maturin>=1.0,<2.0" && \
      maturin build --release --manifest-path /app/zkp-rust/Cargo.toml \
        --out /app/zkp-wheels && \
      pip install /app/zkp-wheels/*.whl ) \
    || echo "WARNING: autonomous_trust_zkp build failed/unavailable; runtime "\
"will run with ZKP_AVAILABLE=False (task-result scoring falls back to "\
"completion-based)." ; \
    rm -rf /app/zkp-rust /app/zkp-wheels "$HOME/.cargo" "$HOME/.rustup"

# Build C library. CMake expects protobuf as a sibling of c-src:
# ${CMAKE_CURRENT_SOURCE_DIR}/../protobuf
ARG GIT_VERSION="unknown"
COPY src/c /app/c-src
COPY src/protobuf /app/protobuf
RUN rm -rf /app/c-src/build && mkdir -p /app/c-src/build && cd /app/c-src/build && \
    CC=clang CXX=clang++ cmake .. -DCMAKE_BUILD_TYPE=Release -DREVISION="$GIT_VERSION" && \
    make -j$(nproc) && \
    cp libautonomous_trust.so /usr/local/lib/ && \
    ldconfig && \
    cd /app && rm -rf /app/c-src

# Copy Python package
COPY src/autonomous-trust/autonomous_trust autonomous_trust
RUN rm -rf autonomous_trust/etc autonomous_trust/var

COPY src/autonomous-trust/pyproject.toml pyproject.toml

ENV AUTONOMOUS_TRUST_ROOT="/"
ENV AUTONOMOUS_TRUST_ENTRY="python3"
ENV AUTONOMOUS_TRUST_BACKEND="native"
ENV AUTONOMOUS_TRUST_LIB="/usr/local/lib/libautonomous_trust.so"
ENV AUTONOMOUS_TRUST_ARGS=""
CMD []
