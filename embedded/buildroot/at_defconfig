# Buildroot defconfig for Autonomous Trust hardened Pi4/CM4 image
# Based on Buildroot 2024.02.x

# Target
BR2_aarch64=y
BR2_cortex_a72=y

# Toolchain: internal, musl libc (smaller than glibc)
BR2_TOOLCHAIN_BUILDROOT_MUSL=y

# System
BR2_TARGET_GENERIC_HOSTNAME="at-node"
BR2_TARGET_GENERIC_ISSUE="Autonomous Trust Node"
BR2_INIT_SYSTEMD=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_AT_PATH)/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_AT_PATH)/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_AT_PATH)/post-image.sh"

# Kernel: custom defconfig
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_AT_PATH)/kernel.defconfig"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2711-rpi-4-b broadcom/bcm2711-rpi-cm4-io"

# Bootloader: U-Boot for Pi4
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="rpi_4"

# Filesystem
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="128M"

# Packages: minimal
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_CONFIG="package/busybox/busybox-minimal.config"

# dm-verity support
BR2_PACKAGE_CRYPTSETUP=y
BR2_PACKAGE_LVM2=y
BR2_PACKAGE_UTIL_LINUX=y

# Firmware: Pi4 bootloader
BR2_PACKAGE_RPI_FIRMWARE=y

# Security: no debug, no docs
# BR2_ENABLE_DEBUG is not set
# BR2_SYSTEM_ENABLE_NLS is not set
