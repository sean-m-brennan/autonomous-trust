# Doxyfile for autonomous_trust C library.
# Run from src/c/:  doxygen Doxyfile
#
# The generated HTML has two top-level sections on the Modules page:
#   - Public API  (embedding surface: autonomous_trust.h and what it exposes)
#   - Internal    (everything under autonomous_trust/, grouped by module)

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = "AutonomousTrust (C)"
PROJECT_BRIEF          = "Distributed trust library — C API"
OUTPUT_DIRECTORY       = doc
OUTPUT_LANGUAGE        = English
TAB_SIZE               = 4
OPTIMIZE_OUTPUT_FOR_C  = YES
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
# Top-level API header + subtree + grouping definitions.
INPUT                  = autonomous_trust.h \
                         autonomous_trust \
                         doxygen_groups.dox
FILE_PATTERNS          = *.h *.c *.dox
RECURSIVE              = YES

# Skip private headers and generated/build artefacts.
EXCLUDE                = build \
                         frama-c \
                         test
EXCLUDE_PATTERNS       = */*_priv.h \
                         */*_priv.h.in \
                         */version.h.in \
                         */*.pb-c.* \
                         */build/*

# Treat ACSL blocks (/*@ ... */) as comments; Doxygen already ignores them
# because they do not begin with /** or /*!. Nothing extra required.

#---------------------------------------------------------------------------
# Extraction
#---------------------------------------------------------------------------
# Only document what is explicitly tagged via @ingroup or @defgroup so the
# two-section structure stays clean. Change to YES to audit coverage.
EXTRACT_ALL            = YES
EXTRACT_STATIC         = NO
EXTRACT_PRIVATE        = NO
EXTRACT_LOCAL_CLASSES  = NO
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

# Keep the Modules page (groups) as the landing point.
SHOW_GROUPED_MEMB_INC  = YES
DISTRIBUTE_GROUP_DOC   = YES
SUBGROUPING            = YES
INLINE_GROUPED_CLASSES = NO
INLINE_SIMPLE_STRUCTS  = NO

#---------------------------------------------------------------------------
# Preprocessing
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
# Hide the C++ `extern "C"` guards and compiler attribute macros from output.
PREDEFINED             = __cplusplus=0 \
                         __attribute__(x)= \
                         __GNUC__=0
# Ignore ACSL predicate/axiomatic blocks so they don't leak into signatures.
SKIP_FUNCTION_MACROS   = YES

#---------------------------------------------------------------------------
# Diagrams (lightweight — no Graphviz required by default)
#---------------------------------------------------------------------------
HAVE_DOT               = NO
CLASS_DIAGRAMS         = YES
GENERATE_TREEVIEW      = YES

#---------------------------------------------------------------------------
# Output formats
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
GENERATE_LATEX         = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

#---------------------------------------------------------------------------
# Warnings (helpful for spotting undocumented symbols over time)
#---------------------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
