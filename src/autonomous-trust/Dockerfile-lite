# Lightweight AutonomousTrust image for demo/proxy-restricted environments
# Prerequisites: generate protobuf Python files first (run-demo.sh.old does this automatically):
#   protoc --python_out=src/autonomous-trust -I src/protobuf $(find src/protobuf -name "*.proto")
# Build with:
#   docker build --network host --build-arg http_proxy=... --build-arg https_proxy=... -t autonomous-trust -f src/autonomous-trust/Dockerfile-lite .

FROM continuumio/miniconda3

ARG http_proxy
ARG https_proxy
ARG no_proxy
ARG CERT_CONTENT

WORKDIR /app
SHELL ["/bin/bash", "-c"]

# Install CA cert for proxy if provided
RUN if [ -n "$CERT_CONTENT" ]; then \
      echo "$CERT_CONTENT" > /usr/local/share/ca-certificates/proxy-ca.crt && \
      cat /usr/local/share/ca-certificates/proxy-ca.crt >> /etc/ssl/certs/ca-certificates.crt; \
    fi
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
ENV PIP_CERT=/etc/ssl/certs/ca-certificates.crt

# Network tools needed by the app (ip route, ping)
RUN apt-get update -y && apt-get install -y --no-install-recommends iproute2 iputils-ping && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY src/autonomous-trust/entrypoint.sh /bin/entrypoint.sh
ENV ROUTER="172.17.0.1"
ENTRYPOINT ["/bin/entrypoint.sh"]

COPY src/autonomous-trust/requirements.txt /app/requirements.txt
RUN pip install -r /app/requirements.txt && pip install protobuf

COPY src/autonomous-trust/autonomous_trust autonomous_trust
RUN rm -rf autonomous_trust/etc autonomous_trust/var

COPY src/autonomous-trust/pyproject.toml pyproject.toml

# --- Clock discipline (required) -------------------------------------------
# AT carries no NTP client of its own. This node refuses to start on a clock
# no daemon is steering: the in-process gate reads ntp_adjtime(modes=0), which
# is honest inside a container because CLOCK_REALTIME is shared with the host
# (a time namespace can offset only CLOCK_MONOTONIC and CLOCK_BOOTTIME).
#
# THE HOST MUST RUN A STOCK NTP DAEMON -- chrony, ntpd or systemd-timesyncd.
# A container cannot discipline CLOCK_REALTIME itself: clock_settime() returns
# EPERM without CAP_SYS_TIME, and granting it would only let the container
# fight its host. So there is deliberately no chronyd in this image.
ENV AT_REQUIRE_SYNCED_CLOCK=1

ENV AUTONOMOUS_TRUST_ROOT="/"
ENV AUTONOMOUS_TRUST_ENTRY="python3"
ENV AUTONOMOUS_TRUST_ARGS=""
CMD []
