# Runs only while at-wifi.service does
[Unit]
Description=Look for the router every minute while in the ad-hoc cell
PartOf=at-wifi.service
After=at-wifi.service

[Timer]
OnActiveSec=60
OnUnitActiveSec=60

[Install]
WantedBy=at-wifi.service
