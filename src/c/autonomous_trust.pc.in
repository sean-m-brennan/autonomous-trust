prefix=@CMAKE_INSTALL_PREFIX@
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/include

Name: autonomous_trust
Description: Autonomous Trust C library
URL: https://github.com/sean-m-brennan/autonomous-trust
Version: @AT_PC_VERSION@
Requires: libsodium@AT_PC_JANSSON_REQUIRES@ uuid libprotobuf-c
Libs: -L${libdir} -lautonomous_trust
Libs.private: @AT_PC_JANSSON_LIBS_PRIVATE@-lpthread -lm
Cflags: -fms-extensions @AT_PC_JANSSON_CFLAGS@-I${includedir} -I${includedir}/autonomous_trust -I${includedir}/autonomous_trust/core/protobuf
