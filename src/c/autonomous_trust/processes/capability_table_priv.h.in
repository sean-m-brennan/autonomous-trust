#ifndef CAPABILITY_TABLE_PRIV_H_IN
#define CAPABILITY_TABLE_PRIV_H_IN

#include "processes/capabilities.h"

#define QUOTE(x) #x

/* Expanded once per DECLARE_CAPABILITY(cap_name, func) call site by
 * scripts/preprocess.py and concatenated into the LIST__ macro below.
 * Emits a row initializer for the static `capability_table[]`. Matches
 * the `capability_t` shape in `processes/capabilities.h` — name + local
 * + function are the bare minimum; `arguments` defaults to a zero-
 * initialized map_t (callers populate it at runtime if they have
 * type metadata). */
/* NB: the second parameter is `cap_func`, NOT `func` — preprocess.py
 * substitutes macro args by plain substring replace, and `func` is a
 * substring of the `.function` field name (it would corrupt it to
 * `.NULLtion`). Mirrors how process_table_priv.h.in names its first
 * param `type_name` (not `type`) to avoid clobbering `.type`. */
#define DECLARE_CAPABILITY(cap_name, cap_func) \
    {                                          \
        .name = QUOTE(cap_name),               \
        .local = true,                         \
        .function = cap_func,                  \
    },


#ifndef CAPABILITY_TABLE_CAPACITY
#define CAPABILITY_TABLE_CAPACITY 128
#endif

/* Trailing sentinel uses a designated initializer so GCC's
 * -Werror=missing-braces accepts it (capability_t has nested sub-structs
 * including an anonymous smrt_ptr_t). Also gives Frama-C's strict parser
 * a non-empty initializer when the declaration list expands to nothing.
 * The sentinel MUST share a line with LIST__... because preprocess.py
 * emits `size_t capability_table_size = N;` on the line immediately
 * following the LIST__ line, and that line must be `};` for the
 * generated code to parse. */
capability_t capability_table[CAPABILITY_TABLE_CAPACITY] = {
    LIST__DECLARE_CAPABILITY { .name = "" }
};

#endif // CAPABILITY_TABLE_PRIV_H_IN
