# Tiltfile for AutonomousTrust pure-C multi-node demo
# Usage: tilt up -- --num-nodes=4 [--log-level=debug]

# We only use docker_compose, not k8s -- allow whatever context is active
allow_k8s_contexts(k8s_context())

num_nodes = os.getenv("_TILT_NUM_NODES", "2")
log_level = os.getenv("_TILT_LOG_LEVEL", "info")

# Generate docker-compose.tilt.yaml (reuse gen_compose.py with backend=c)
local("cd .. && python3 gen_compose.py " + num_nodes + " network " + log_level + " c", quiet=True, echo_off=True)

# Build args: pass through proxy env vars if set
build_args = {}
for var in ["http_proxy", "https_proxy", "no_proxy"]:
    val = os.getenv(var, "")
    if val:
        build_args[var] = val

# Auto-detect proxy CA cert: env var first, then well-known filesystem path
cert_content = os.getenv("CERT_CONTENT", "")
if not cert_content:
    cert_path = "/usr/local/share/ca-certificates/proxy-ca.crt"
    result = str(local("cat " + cert_path + " 2>/dev/null || true", quiet=True, echo_off=True))
    if result.strip():
        cert_content = result.strip()
if cert_content:
    build_args["CERT_CONTENT"] = cert_content

# Get version from git for C library build
git_version = str(local("git describe HEAD 2>/dev/null || echo unknown", quiet=True, echo_off=True)).strip()
git_version = git_version.removeprefix("v")
build_args["GIT_VERSION"] = git_version

# Build the pure-C image
docker_build(
    "autonomous-trust",
    ".",
    dockerfile="src/autonomous-trust/Dockerfile-c",
    network="host",
    build_args=build_args,
)

# Load the generated compose file
docker_compose("docker-compose.tilt.yaml")

# Exclude generated compose file from Tilt's file watch
watch_settings(ignore=["docker-compose.tilt.yaml"])

# Watch only C source dirs for live rebuild triggers
watch_file("src/c")
watch_file("src/protobuf")
watch_file("src/autonomous-trust/entrypoint-c.sh")
