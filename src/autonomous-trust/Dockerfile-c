# AutonomousTrust pure-C image (no Python at runtime)
# Multi-stage: build C library + at_demo, then copy to minimal runtime image.
# Build with:
#   docker build --network host -t autonomous-trust-c -f src/autonomous-trust/Dockerfile-c .

####################
# Stage 1: Builder
####################
FROM debian:bookworm AS builder

ARG http_proxy
ARG https_proxy
ARG no_proxy
ARG CERT_CONTENT
ARG GIT_VERSION="unknown"

# Install CA cert for proxy if provided
RUN if [ -n "$CERT_CONTENT" ]; then \
      echo "$CERT_CONTENT" > /usr/local/share/ca-certificates/proxy-ca.crt && \
      update-ca-certificates; \
    fi

RUN apt-get update -y && apt-get install -y --no-install-recommends \
        python3 python-is-python3 \
        cmake clang make pkg-config libc-dev \
        uuid-dev libsodium-dev libjansson-dev \
        protobuf-compiler protobuf-c-compiler libprotobuf-c-dev libprotobuf-dev && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy the examples project plus the library and protobuf sources it depends on.
# at_demo is built by examples/CMakeLists.txt, NOT by src/c (which only builds
# the library). The examples build add_subdirectory()s the library via the
# sibling path ../src/c, and the library in turn finds protobuf via ../protobuf.
# Preserve that sibling layout under /build so both relative paths resolve:
#   /build/examples  ->  ../src/c == /build/src/c  ->  ../protobuf == /build/src/protobuf
COPY examples /build/examples
COPY src/c /build/src/c
COPY src/protobuf /build/src/protobuf

RUN rm -rf /build/examples/build && mkdir -p /build/examples/build && cd /build/examples/build && \
    CC=clang CXX=clang++ cmake .. -DCMAKE_BUILD_TYPE=Release -DREVISION="$GIT_VERSION" -DCMAKE_C_FLAGS="-Wno-unknown-warning-option" -DCMAKE_CXX_FLAGS="-Wno-unknown-warning-option" && \
    make -j$(nproc) && \
    make install DESTDIR=/build/install

####################
# Stage 2: Runtime
####################
FROM debian:bookworm-slim

ARG CERT_CONTENT

# Install CA cert for proxy if provided
RUN if [ -n "$CERT_CONTENT" ]; then \
      echo "$CERT_CONTENT" > /usr/local/share/ca-certificates/proxy-ca.crt && \
      update-ca-certificates; \
    fi

RUN apt-get update -y && apt-get install -y --no-install-recommends \
        libsodium23 libjansson4 libuuid1 \
        libprotobuf-c1 libprotobuf32 \
        iproute2 iputils-ping && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Copy built artifacts from builder
COPY --from=builder /build/install/usr/local/bin/at_demo /opt/autonomous-trust/bin/at_demo
COPY --from=builder /build/install/usr/local/lib/libautonomous_trust.so /opt/autonomous-trust/lib/libautonomous_trust.so
RUN echo "/opt/autonomous-trust/lib" > /etc/ld.so.conf.d/autonomous-trust.conf && ldconfig
ENV PATH="/opt/autonomous-trust/bin:$PATH"

COPY src/autonomous-trust/entrypoint-c.sh /bin/entrypoint-c.sh
RUN chmod +x /bin/entrypoint-c.sh

# Pre-create data dirs writable by any UID (supports user: in compose)
RUN mkdir -p /etc/at /var/at && chmod 777 /etc/at /var/at

ENV AUTONOMOUS_TRUST_ROOT="/"
ENV ROUTER="172.17.0.1"

ENTRYPOINT ["/bin/entrypoint-c.sh"]
CMD []
