# Generic builder for conda packages
# Supports Rust/C/C++ extensions built with either 'python -m build' or 'maturin build'
# User must provide sources, including a meta.yaml file for conda-build

# Create multi-arch containers with: docker buildx build --platform linux/amd64,linux/arm64 --tag package-builder .
# Run with: docker run --rm -u $(id -u):$(id -g) -v /tmp:/tmp -v ~/path/to/source:/build/src -v ~/path/to/dist:/build/dist [-it | -d] package-builder:<arch>

# Workaround for https://github.com/conda/conda-build/issues/1482:
# Use short --croot, --no-build-id, and --prefix-length to keep placeholder paths
# within Docker's filesystem limits. Also use 'python' instead of {{PYTHON}} in meta.yaml.

# Pinned by tag AND digest; single source of truth is
# config/cfg/toolchain-pins.env. Tags get re-pushed, so the
# digest is the part that actually fixes the contents.
ARG MINIFORGE_IMAGE=condaforge/miniforge3:26.1.1-3@sha256:958d2675e9a43e199cc85345ff4c60796236b651a9da4982765d99bd34a682d1
FROM ${MINIFORGE_IMAGE}

ARG http_proxy
ARG https_proxy
ARG no_proxy
ARG CERT_CONTENT

ENV http_proxy=${http_proxy}
ENV https_proxy=${https_proxy}
ENV no_proxy=${no_proxy}

WORKDIR /build
SHELL ["/bin/bash", "-c"]

# Install CA cert for proxy if provided (must happen before any network access)
RUN if [ -n "$CERT_CONTENT" ]; then \
      echo "$CERT_CONTENT" > /usr/local/share/ca-certificates/proxy-ca.crt && \
      cat /usr/local/share/ca-certificates/proxy-ca.crt >> /etc/ssl/certs/ca-certificates.crt && \
      conda config --set ssl_verify /etc/ssl/certs/ca-certificates.crt; \
    fi
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

RUN apt update -y && apt install -y curl build-essential && apt clean

# Deliberately NO `conda update -n base conda`: an unbounded base-env update
# undoes the pinned FROM above, since it pulls whatever conda conda-forge
# published today. That is one of the two drifts that let an upstream defect
# reach a working build on 2026-08-04. To move conda here,
# move the pin in config/cfg/toolchain-pins.env instead.
RUN conda config --add channels conda-forge
# NB: builder-base Python only — the built packages' Python is set by meta.yaml,
# independent of this pin. conda-verify dropped (deprecated; its recipe checks
# are folded into modern conda-build) which lifts the python <3.12 cap; pinned
# at 3.12 (mercurial has no cp313 build on conda-forge — it jumps cp312 -> cp314).
RUN conda install -y -n base python=3.12 conda-build pip python-build maturin mercurial

WORKDIR /build/src
ENV TEMPDIR=/build
RUN mkdir $TEMPDIR/conda-bld && chmod 777 $TEMPDIR/conda-bld
ARG UID=1000
RUN useradd -U user -u $UID -d /build/src || usermod -d /build/src $(getent passwd $UID | cut -d: -f1)
RUN mkdir /build/dist
RUN mkdir /cb && chmod 777 /cb

ENV CARGO_HOME="/opt/rust"
RUN curl --proto '=https' --tlsv1.2 https://sh.rustup.rs -sSf | sh -s -- -y --profile minimal
ENV PATH="/opt/rust/bin:${PATH}"
RUN rustup install nightly && rustup default nightly

ENV EXTRA_ARGS="--no-build-id --prefix-length 80 --prefix-length-fallback"
CMD ["/bin/bash", "-c", "conda build -c conda-forge --no-verify $EXTRA_ARGS --croot /cb --output-folder /build/dist ."]

